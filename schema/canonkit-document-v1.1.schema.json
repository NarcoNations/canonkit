{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonkit.dev/schema/canonkit-document-v1.1.schema.json",
  "title": "CanonKit document metadata 1.1",
  "description": "The CanonKit 1.1 metadata contract, separating document identity from governed subjects and typed lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "status",
    "authority",
    "owner",
    "version",
    "visibility"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "id": {
      "$ref": "#/$defs/identity"
    },
    "kind": {
      "description": "The governed role of this document, independent of its authority or lifecycle.",
      "enum": ["canon", "decision", "policy", "reference"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "enum": ["draft", "review", "active", "superseded", "archived"]
    },
    "authority": {
      "enum": ["canonical", "approved", "reference", "derived", "unverified"]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "visibility": {
      "enum": ["public", "internal", "restricted"]
    },
    "scope": {
      "$ref": "#/$defs/identity"
    },
    "subjects": {
      "description": "Stable identities for the things this document governs, describes, or affects.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "aliases": {
      "description": "Historical or alternative human-readable names used to find this document's subjects.",
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "relations": {
      "description": "Typed subject or governance relationships. Document-version replacement remains in supersedes.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "enum": [
              "part_of",
              "governed_by",
              "decided_by",
              "evolved_from",
              "replaces",
              "related_to"
            ]
          },
          "target": {
            "$ref": "#/$defs/identity"
          }
        }
      }
    },
    "supersedes": {
      "description": "Stable document identities, optionally followed by @version, replaced by this document version.",
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/versionedIdentity"
      }
    },
    "review_after": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identity"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": ["canon", "decision"]
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["subjects"],
        "properties": {
          "subjects": {}
        }
      }
    }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
    },
    "versionedIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 193,
      "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*(?:@[^@\\s]{1,64})?$"
    }
  }
}
