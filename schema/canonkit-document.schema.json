{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonkit.dev/schema/canonkit-document.schema.json",
  "title": "CanonKit document metadata",
  "description": "The public metadata contract for a CanonKit-governed document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "authority",
    "owner",
    "version",
    "visibility"
  ],
  "properties": {
    "schema_version": {
      "description": "The CanonKit metadata contract version. CanonKit v0.1 supports exactly 1.0.",
      "const": "1.0"
    },
    "id": {
      "description": "A stable, repository-local document identity.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
    },
    "title": {
      "description": "A human-readable document title.",
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "description": "The document lifecycle state.",
      "enum": ["draft", "review", "active", "superseded", "archived"]
    },
    "authority": {
      "description": "The document's role in authority decisions.",
      "enum": ["canonical", "approved", "reference", "derived", "unverified"]
    },
    "owner": {
      "description": "The person, role, or team accountable for the document.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "description": "A human-readable document version.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "visibility": {
      "description": "The access class used by fail-closed output policy.",
      "enum": ["public", "internal", "restricted"]
    },
    "scope": {
      "description": "The repository-local area in which this document may govern.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
    },
    "supersedes": {
      "description": "Stable document identities, optionally followed by @version, replaced by this document.",
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 193,
        "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*(?:@[^@\\s]{1,64})?$"
      }
    },
    "review_after": {
      "description": "An ISO 8601 calendar date after which review is due.",
      "type": "string",
      "format": "date"
    },
    "tags": {
      "description": "Optional lower-case discovery labels.",
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
      }
    }
  }
}
