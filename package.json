{
  "name": "@narconations/canonkit",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "A local-first trust layer for repository documentation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NarcoNations/canonkit.git"
  },
  "homepage": "https://github.com/NarcoNations/canonkit#readme",
  "bugs": {
    "url": "https://github.com/NarcoNations/canonkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "canonkit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\"",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
